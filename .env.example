# Copy to .env for local development. On the Space these go in Settings -> Variables and secrets.
# Never commit a real token.

# Secret. Needed for hosted Qwen on the allow and redact routes; without it the decision still
# stands and the response box shows a notice.
HF_TOKEN=

# Optional. Defaults are in brackets.
SITR_HF_MODELS=1              # [1] 0 turns the detection models off and runs rules only
SITR_LLM=live                 # [live] mock returns canned text instead of calling Qwen
SITR_LLM_PROVIDER=featherless-ai
SITR_AUDIT_ENABLED=true       # [true] privacy-safe metadata only; never input content
SITR_MODEL_TIMEOUT=30         # [30] seconds, detection and risk models
SITR_LLM_TIMEOUT=30           # [30] seconds, hosted Qwen
SITR_PRIVATE_TIMEOUT=60       # [60] seconds, Qwen on the private route
